#
# mcp: the MCP server that exposes vmd and agentd to MCP clients such as Claude. Build from the repository root:
#   docker build -f deploy/Dockerfile.mcp -t attic/mcp .

FROM golang:1.26 AS build
WORKDIR /src

# Download modules first so source-only changes reuse this layer.
# Copy the workspace file and every module's go.mod and go.sum first, so this layer depends only on manifests.
# Each module has replace directives pointing at sibling directories, so all of their manifests are needed.
COPY go.work go.work.sum ./
COPY api/go.mod api/go.sum api/
COPY libs/common/go.mod libs/common/go.sum libs/common/
COPY libs/authz/go.mod libs/authz/go.sum libs/authz/
COPY libs/qemu/go.mod libs/qemu/go.sum libs/qemu/
COPY libs/server/go.mod libs/server/go.sum libs/server/
COPY services/vmd/go.mod services/vmd/go.sum services/vmd/
COPY services/agentd/go.mod services/agentd/go.sum services/agentd/
COPY services/mcp/go.mod services/mcp/go.sum services/mcp/
COPY cmd/atticctl/go.mod cmd/atticctl/go.sum cmd/atticctl/
COPY e2e/go.mod e2e/go.sum e2e/
RUN cd services/mcp && go mod download

COPY . .
RUN cd services/mcp && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/mcp ./cmd/mcp

# Distroless static image: no shell, no package manager, runs as the nonroot user.
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/mcp /mcp
EXPOSE 8082
ENTRYPOINT ["/mcp"]
