# syntax=docker/dockerfile:1
#
# node: a VM host running the vmd binary with --role=node. Build from the repository root:
#   docker build -f deploy/Dockerfile.node -t homecloud/node .
#
# Nodes normally run on the bare host, not in a container, because they need direct access to
# /dev/kvm, bridge networking and local disk images. This image exists for development and for
# hosts that prefer containers. It needs --privileged or equivalent device access for KVM.

FROM golang:1.26 AS build
WORKDIR /src

# Download modules first so source-only changes reuse this layer; the cache mount keeps them across builds.
# Copy the workspace file and every module's go.mod and go.sum first, so this layer depends only on manifests.
# Each module has replace directives pointing at sibling directories, so all of their manifests are needed.
COPY go.work go.work.sum ./
COPY api/go.mod api/go.sum api/
COPY libs/common/go.mod libs/common/go.sum libs/common/
COPY libs/authz/go.mod libs/authz/go.sum libs/authz/
COPY libs/qemu/go.mod libs/qemu/go.sum libs/qemu/
COPY libs/server/go.mod libs/server/go.sum libs/server/
COPY services/vmd/go.mod services/vmd/go.sum services/vmd/
COPY services/agentd/go.mod services/agentd/go.sum services/agentd/
COPY services/mcp/go.mod services/mcp/go.sum services/mcp/
COPY cmd/hcctl/go.mod cmd/hcctl/go.sum cmd/hcctl/
COPY e2e/go.mod e2e/go.sum e2e/
RUN --mount=type=cache,target=/go/pkg/mod cd services/vmd && go mod download

COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    cd services/vmd && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/vmd ./cmd/vmd

# Debian stable slim provides the qemu tools the node driver shells out to.
FROM debian:stable-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      qemu-system-x86 \
      qemu-utils \
      genisoimage \
      openssh-client \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/vmd /vmd
EXPOSE 8080
ENTRYPOINT ["/vmd", "--role=node"]
